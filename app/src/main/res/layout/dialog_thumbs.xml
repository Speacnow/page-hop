<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/reader_bg">

    <com.pageflow.reader.ui.ZoomGrid
        android:id="@+id/thumbGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="46dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- 左上角悬浮关闭按钮 -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_floating_button"
        android:contentDescription="@string/cancel"
        android:elevation="8dp"
        android:src="@drawable/ic_close" />

    <!-- 长按预览：网格之上盖一层半透明大图 -->
    <FrameLayout
        android:id="@+id/previewLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#4D000000" />

        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.32"
            android:contentDescription="@string/thumbs"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- 底栏：进度条 + 当前页 + 列数 -->
    <LinearLayout
        android:id="@+id/thumbBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/reader_bar"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingEnd="14dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/tvMapPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:progressDrawable="@drawable/seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/seek_thumb" />

        <TextView
            android:id="@+id/tvDensity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDensityBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_chip"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
