<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.PageFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/brand_on</item>
    </style>

    <style name="Theme.PageFlow.Reader" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/reader_bg</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/brand_on</item>
    </style>

    <!-- 设置整页：跟阅读器一样深色底，避免打开时白底闪一下 -->
    <style name="Theme.PageFlow.Settings" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/reader_bg</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/brand_on</item>
    </style>

</resources>
